{
  "expo": {
    "name": "ScanDoc",
    "slug": "scandoc",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "scandoc",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.scandoc.scanner",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#061A40",
          "image": "./assets/icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ScanDoc uses your camera to scan documents.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose images to process locally in ScanDoc.",
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      "expo-sharing",
      "expo-font",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "enforceContrast": false,
        "hidden": false
      },
      "eas": {
        "projectId": "3e3329c6-1508-401d-825b-dd44fe32da09"
      }
    }
  }
}
